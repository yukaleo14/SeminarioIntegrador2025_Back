model Estado { 
  id    Int    @id @default(autoincrement())
  fechaHora DateTime @default(now())
  ambito Ambito
  nombre Nombre 

  sucursal Sucursal[]
  pago Pago[]
  pedido Pedido[]
  producto Producto[]
}

enum Ambito {
  PEDIDO
  PRODUCTO
  PAGO
  SUCURSAL
}

enum Nombre {
  CREADO
  ENPREPARACION
  PUBLICADO
  TOMADO
  ENRUTA
  ENTREGADO
  CANCELADO
  DEMORADO
  PENDIENTE
  ABIERTO
  CERRADO
}

model Pedido {
  id    Int    @id @default(autoincrement())
  numero String @unique
  horaLlegadaEstimada DateTime @unique
  montoTotal Int @unique
  tiempoPreparacionEstimado Int @unique
  tiempoRepartoEstimado Int @unique
  fechaHora DateTime @default(now())
  
  cliente Usuario? @relation("clientePedidos", fields: [usuarioId], references: [id])
  usuarioId Int @unique
  delivery Usuario? @relation("deliveryPedidos", fields: [deliveryId], references: [id])
  deliveryId Int @unique
  company Usuario? @relation("companyPedidos", fields: [companyId], references: [id])
  companyId Int @unique

  ruta Ruta @relation(fields: [rutaId], references: [id])
  rutaId Int

  pago Pago @relation(fields: [pagoId], references: [id])
  pagoId Int

  estado Estado @relation(fields: [estadoId], references: [id])
  estadoId Int

  detalle DetalleDePedido[]

}

model DetalleDePedido {
  id    Int    @id @default(autoincrement())
  cantidad Int
  montoSubtotal Float
  fechaHora DateTime @default(now())

  pedido Pedido @relation(fields: [pedidoId], references: [id])
  pedidoId Int

  producto Producto @relation(fields: [productoId], references: [id])
  productoId Int
}


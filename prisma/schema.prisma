generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id    Int    @id @default(autoincrement())
  mail String @unique
  nombre  String
  apellido String
  dni   String @unique
  telefono String @unique
  fechaHora DateTime @default(now())
  cuit String?
  contraseña String

  //en caso de ser sucursal, tendra una ubicacion
  ubicacion Ubicacion? @relation(fields: [ubicacionId], references: [id])
  ubicacionId Int?

  //agregar producto para que la empresa pueda tener varios productos a la venta, si se desea

  // cambiar, solo debe tener una sucursal
  sucursales Sucursal[]

  //el usuario puede tener varios Roles
  cliente Pedido[] @relation("clientePedidos") 
  delivery Pedido[] @relation("deliveryPedidos")
  company Pedido[] @relation("companyPedidos")

  rol Rol @default(CLIENTE)
}

enum Rol {
  CLIENTE
  DELIVERY
  EMPRESA
}


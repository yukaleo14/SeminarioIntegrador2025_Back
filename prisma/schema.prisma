generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  name  String
  surname String
  dni   String @unique
  telephone String @unique
  createdAt DateTime @default(now())
  password String

  //en caso de ser sucursal, tendra una ubicacion
  ubicacion Ubicacion? @relation(fields: [ubicacionId], references: [id])
  ubicacionId Int?

  Sucursales Sucursal[]

  //el usuario puede tener varios Rols
  cliente Order[] @relation("clienteOrders") 
  delivery Order[] @relation("deliveryOrders")
  company Order[] @relation("companyOrders")

  rol Rol @default(CLIENTE)
}

enum Rol {
  CLIENTE
  DELIVERY
  BUSINESS
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  createdAt DateTime @default(now())
  products Producto[]
}

model Producto {
  id    Int    @id @default(autoincrement())
  name  String
  unitPrice Float
  category Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  createdAt DateTime @default(now())

  estado Estado @relation(fields: [estadoId], references: [id])
  estadoId Int

  orderDetails OrderDetail[]
}

model Sucursal {
  id    Int    @id @default(autoincrement())
  name  String
  address String @unique
  Horario Horario[]

  estado Estado @relation(fields: [estadoId], references: [id])
  estadoId Int
  user User? @relation(fields: [userId], references: [id])
  userId Int?
}

model Horario {
  id    Int    @id @default(autoincrement())
  openTime String
  closeTime String
  sucursal Sucursal @relation(fields: [sucursalId], references: [id])
  sucursalId Int
  dia Dia
}

enum Dia {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

model Pago {
  id    Int    @id @default(autoincrement())
  createdAt DateTime @default(now())
  nrpago String @unique
  pagoDate DateTime @default(now())
  mount Float
  methodpago Methodpago @relation(fields: [methodpagoId], references: [id])
  methodpagoId Int
  Estado Estado @relation(fields: [EstadoId], references: [id])
  EstadoId Int

  order Order[]
}

model Methodpago {
  id    Int    @id @default(autoincrement())
  createdAt DateTime @default(now())
  name String
  pago Pago[]
}

model Estado {
  id    Int    @id @default(autoincrement())
  createdAt DateTime @default(now())
  ambito Ambito
  nombre Nombre 

  sucursal Sucursal[]
  pago Pago[]
  pedido Order[]
  producto Producto[]
}

enum Ambito {
  PEDIDO
  PRODUCTO
  PAGO
}

enum Nombre {
  CREADO
  ENPREPARACION
  PUBLICADO
  TOMADO
  ENRUTA
  ENTREGADO
  CANCELADO
  DEMORADO


}

model Order {
  id    Int    @id @default(autoincrement())
  nrOrder String @unique
  arrivalTime DateTime @unique
  totalMount Int @unique
  preparationTime Int @unique
  distributionTime Int @unique
  createdAt DateTime @default(now())
  
  cliente User? @relation("clienteOrders", fields: [userId], references: [id])
  userId Int @unique
  delivery User? @relation("deliveryOrders", fields: [deliveryId], references: [id])
  deliveryId Int @unique
  company User? @relation("companyOrders", fields: [companyId], references: [id])
  companyId Int @unique

  ruta Ruta @relation(fields: [rutaId], references: [id])
  rutaId Int

  pago Pago @relation(fields: [pagoId], references: [id])
  pagoId Int

  estado Estado @relation(fields: [estadoId], references: [id])
  estadoId Int

  orderDetails OrderDetail[]

}

model OrderDetail {
  id    Int    @id @default(autoincrement())
  quantity Int
  unitPrice Float
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
  orderId Int

  product Producto @relation(fields: [productId], references: [id])
  productId Int
}

model Ruta {
  id    Int    @id @default(autoincrement())
  tarifaDistancia Float
  createdAt DateTime @default(now())
  pedido Order[]
  origen Ubicacion @relation("OrigenUbicacion", fields: [origenId], references: [id])
  origenId Int
  destino Ubicacion @relation("DestinoUbicacion", fields: [destinoId], references: [id])
  destinoId Int
  ubicacionId Int
}

model Ubicacion {
  id    Int    @id @default(autoincrement())
  coordenadaX Float
  coordenadaY Float
  createdAt DateTime @default(now())
  origen Ruta[] @relation("OrigenUbicacion")
  destino Ruta[] @relation("DestinoUbicacion")
  sucursal User[]
}
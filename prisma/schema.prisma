generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  name  String
  surname String
  dni   String @unique
  telephone String @unique
  createdAt DateTime @default(now())
  password String


  branches Branch[]

  role Role @default(CLIENT)
}

enum Role {
  CLIENT
  DELIVERY
  BUSINESS
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  createdAt DateTime @default(now())
  products Product[]
}

model Product {
  id    Int    @id @default(autoincrement())
  name  String
  unitPrice Float
  category Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  createdAt DateTime @default(now())
}

model Branch {
  id    Int    @id @default(autoincrement())
  name  String
  address String
  hours Hours[]

  user User @relation(fields: [userId], references: [id])
  userId Int
}

model Hours {
  id    Int    @id @default(autoincrement())
  openTime String
  closeTime String
  branch Branch @relation(fields: [branchId], references: [id])
  branchId Int
  day Day @relation(fields: [dayId], references: [id]) 
  dayId Int
}

model Day {
  id    Int    @id @default(autoincrement())
  name  String @unique
  hours Hours[]
}


model Pay {
  id    Int    @id @default(autoincrement())
  createdAt DateTime @default(now())
  nrPay String @unique
  payDate DateTime @default(now())
  mount Float
  methodPay MethodPay @relation(fields: [methodPayId], references: [id])
  methodPayId Int
  state State @relation(fields: [stateId], references: [id])
  stateId Int
}

model MethodPay {
  id    Int    @id @default(autoincrement())
  createdAt DateTime @default(now())
  name String
  pay Pay[]
}

model State {
  id    Int    @id @default(autoincrement())
  createdAt DateTime @default(now())
  ambit String
  name String
  pay Pay[]
}